# Bake a locally available Xray binary into the Hexogate Node image.
#
# Use this on a host that already has your Xray build (for example the
# hexogate.5 binary the fleet bind-mounts today) to produce an image that
# carries it, so nodes no longer need the bind mount:
#
#   cp /usr/local/lib/hexogate-manual-tunnels/xray-26.3.27-hexogate.5 ./xray
#   docker build -f Dockerfile.local-core \
#     --build-arg XRAY_SHA256=<sha256 of ./xray> \
#     -t hexogate-node:hexogate.5 .
#
# The build fails unless ./xray matches XRAY_SHA256 and runs.
ARG BASE_IMAGE=ghcr.io/jellyendersoon/hexogate-node:latest
FROM ${BASE_IMAGE}

ARG XRAY_SHA256
COPY xray /usr/local/bin/xray
RUN test -n "${XRAY_SHA256}" || { echo "XRAY_SHA256 build arg is required" >&2; exit 1; }; \
    echo "${XRAY_SHA256}  /usr/local/bin/xray" | sha256sum -c - && \
    chmod 0755 /usr/local/bin/xray && \
    /usr/local/bin/xray version | head -n 1
